<group name="custom_mysql,authentication_failed,">

  <rule id="100200" level="5">
    <decoded_as>mysql_custom</decoded_as>
    <match>Access denied for user</match>
    <description>MySQL: authentication failure detected</description>
  </rule>

  <rule id="100201" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>MySQL: brute-force authentication attack detected</description>
  </rule>

</group>
